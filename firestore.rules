rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function own(uid) { return verified() && request.auth.uid == uid; }
    function admin() {
      return verified()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function audit() {
      return request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function plan(value) { return value in ['basic','standard','premium','mittag','cowork']; }
    function cafeId(value) { return value is string && value.matches('^[A-Za-z0-9_-]{1,100}$'); }
    function staffValues() {
      return cafeId(request.resource.data.cafeId)
        && request.resource.data.cafeName is string
        && request.resource.data.cafeName.size() > 0
        && request.resource.data.cafeName.size() <= 120
        && request.resource.data.active is bool;
    }
    function review() {
      return request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.uid;
    }
    match /admins/{uid} {
      allow get: if own(uid);
      allow list, create, update, delete: if false;
    }
    match /members/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasAll(['name','email','memberId','remaining','active','createdAt'])
        && request.resource.data.keys().hasOnly(['name','email','memberId','remaining','active','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.memberId == 'MF-' + uid
        && request.resource.data.remaining is int && request.resource.data.remaining == 0
        && request.resource.data.active == false
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['plan','remaining','active','updatedAt','updatedBy'])
        && plan(request.resource.data.plan)
        && request.resource.data.remaining is int
        && request.resource.data.remaining >= 0 && request.resource.data.remaining <= 10000
        && request.resource.data.active is bool && audit();
      allow delete: if false;
    }
    match /membershipRequests/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['plan','email','status','requestedAt'])
        && plan(request.resource.data.plan)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow update: if (own(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan','email','status','requestedAt'])
        && plan(request.resource.data.plan)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time)
        || (admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy'])
          && review()
          && resource.data.status == 'pending'
          && (request.resource.data.status == 'rejected'
            || (getAfter(/databases/$(database)/documents/members/$(uid)).data.active == true
              && getAfter(/databases/$(database)/documents/members/$(uid)).data.plan == resource.data.plan)));
      allow delete: if false;
    }
    match /staff/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if admin() && staffValues() && audit()
        && request.resource.data.keys().hasOnly(['cafeId','cafeName','active','updatedAt','updatedBy']);
      allow update: if admin() && staffValues() && audit()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['cafeId','cafeName','active','updatedAt','updatedBy']);
      allow delete: if false;
    }
    match /cafeApplications/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.keys().hasOnly(['cafeName','address','email','status','createdAt','partnerAgreementVersion','partnerAgreementAt'])
        && request.resource.data.partnerAgreementVersion == '2026-10-19'
        && request.resource.data.partnerAgreementAt == request.time
        && request.resource.data.cafeName is string
        && request.resource.data.cafeName.size() > 0 && request.resource.data.cafeName.size() <= 120
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 250
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy','cafeId'])
        && review()
        && resource.data.status == 'pending'
        && (request.resource.data.status == 'rejected'
          || (cafeId(request.resource.data.cafeId)
            && getAfter(/databases/$(database)/documents/staff/$(uid)).data.active == true
            && getAfter(/databases/$(database)/documents/staff/$(uid)).data.cafeId == request.resource.data.cafeId));
      allow delete: if false;
    }
    match /cafes/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /redemptions/{id} {
      allow get, list: if admin() || (verified() && (resource.data.memberUid == request.auth.uid || resource.data.staffUid == request.auth.uid));
      allow create, delete: if false;
      allow update: if admin()
        && resource.data.get('paymentStatus', 'open') == 'open'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['paymentStatus','paidAt','paidBy','paymentReference'])
        && request.resource.data.paymentStatus == 'paid'
        && request.resource.data.paidAt == request.time
        && request.resource.data.paidBy == request.auth.uid
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() >= 3
        && request.resource.data.paymentReference.size() <= 160;
    }
    // Shared structure for carwash, bowling and later services. Existing coffee paths stay intact.
    match /services/{serviceId} {
      allow read: if verified();
      allow create, update: if admin() && serviceId.matches('^[a-z][a-z0-9_-]{1,39}$')
        && request.resource.data.keys().hasOnly(['name','active','updatedAt','updatedBy'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80 && request.resource.data.active is bool && audit();
      allow delete: if false;
      function company(uid) {
        return verified() && get(/databases/$(database)/documents/services/$(serviceId)/companies/$(uid)).data.active == true;
      }
      function enabled() {
        return get(/databases/$(database)/documents/services/$(serviceId)).data.active == true;
      }
      function subscription(uid) {
        return get(/databases/$(database)/documents/services/$(serviceId)/subscriptions/$(uid)).data;
      }
      function afterSubscription(uid) {
        return getAfter(/databases/$(database)/documents/services/$(serviceId)/subscriptions/$(uid)).data;
      }
      function requestBefore(id) {
        return get(/databases/$(database)/documents/services/$(serviceId)/requests/$(id)).data;
      }
      function requestAfter(id) {
        return getAfter(/databases/$(database)/documents/services/$(serviceId)/requests/$(id)).data;
      }
      function ledgerAfter(id) {
        return getAfter(/databases/$(database)/documents/services/$(serviceId)/redemptions/$(id)).data;
      }
      function usable(s) { return s.active == true && s.remaining > 0 && s.validUntil > request.time; }
      function companyFields(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 120
          && d.address is string && d.address.size() > 0 && d.address.size() <= 250;
      }
      match /companies/{uid} {
        allow get: if own(uid) || admin();
        allow list: if admin();
        allow create: if own(uid) && companyFields(request.resource.data)
          && request.resource.data.partnerAgreementVersion == '2026-10-19'
          && request.resource.data.partnerAgreementAt == request.time
          && request.resource.data.keys().hasOnly(['name','address','email','status','active','createdAt','partnerAgreementVersion','partnerAgreementAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.status == 'pending' && request.resource.data.active == false
          && request.resource.data.createdAt == request.time;
        allow update: if admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','active','reviewedAt','reviewedBy'])
          && review() && request.resource.data.active is bool
          && (request.resource.data.status == 'approved' || request.resource.data.active == false);
        allow delete: if false;
      }
      match /offers/{id} {
        allow read: if verified() && (admin() || resource.data.active == true || resource.data.companyId == request.auth.uid);
        allow create, update: if admin() && company(request.resource.data.companyId)
          && request.resource.data.keys().hasOnly(['name','description','companyId','companyName','address','units','periodDays','priceCents','payoutCents','active','updatedAt','updatedBy'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
          && request.resource.data.description is string && request.resource.data.description.size() <= 500
          && request.resource.data.companyName is string && request.resource.data.address is string
          && request.resource.data.units is int && request.resource.data.units >= 1 && request.resource.data.units <= 1000
          && request.resource.data.periodDays is int && request.resource.data.periodDays >= 1 && request.resource.data.periodDays <= 366
          && request.resource.data.priceCents is int && request.resource.data.priceCents > 0 && request.resource.data.priceCents <= 10000000
          && request.resource.data.payoutCents is int && request.resource.data.payoutCents >= 0 && request.resource.data.payoutCents <= 10000000
          && request.resource.data.active is bool && audit();
        allow delete: if false;
      }
      match /applications/{uid} {
        allow get: if own(uid) || admin();
        allow list: if admin();
        allow create, update: if (own(uid)
          && (!exists(/databases/$(database)/documents/services/$(serviceId)/applications/$(uid)) || resource.data.status != 'pending')
          && request.resource.data.keys().hasOnly(['uid','name','email','offerId','status','requestedAt'])
          && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 320
          && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time
          && get(/databases/$(database)/documents/services/$(serviceId)/offers/$(request.resource.data.offerId)).data.active == true)
          || (admin() && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy']) && review()
            && (request.resource.data.status == 'rejected' || (afterSubscription(uid).active == true
              && afterSubscription(uid).offerId == resource.data.offerId)));
        allow delete: if false;
      }
      match /subscriptions/{uid} {
        function hasPendingCompanyAccess() {
          return company(request.auth.uid) && resource.data.companyId == request.auth.uid
            && resource.data.activeRequestId != ''
            && requestBefore(resource.data.activeRequestId).status == 'pending'
            && requestBefore(resource.data.activeRequestId).uid == uid;
        }
        function validAdminValues() {
          return request.resource.data.keys().hasOnly(['uid','name','email','offerId','offerName','companyId','companyName','remaining','payoutCents','priceCents','active','activeRequestId','validUntil','paymentReference','updatedAt','updatedBy'])
            && request.resource.data.uid == uid && request.resource.data.name is string && request.resource.data.email is string
            && request.resource.data.offerId is string && request.resource.data.offerName is string
            && request.resource.data.companyId is string && request.resource.data.companyName is string
            && request.resource.data.remaining is int && request.resource.data.remaining >= 0 && request.resource.data.remaining <= 10000
            && request.resource.data.payoutCents is int && request.resource.data.payoutCents >= 0
            && request.resource.data.priceCents is int && request.resource.data.priceCents >= 0
            && request.resource.data.active is bool && request.resource.data.activeRequestId is string
            && request.resource.data.validUntil is timestamp
            && request.resource.data.paymentReference is string && request.resource.data.paymentReference.size() >= 3
            && request.resource.data.paymentReference.size() <= 160 && audit();
        }
        allow get: if own(uid) || admin() || (verified() && hasPendingCompanyAccess());
        allow list: if admin();
        allow create: if admin() && validAdminValues() && request.resource.data.activeRequestId == '';
        allow update: if (admin() && validAdminValues())
          || (own(uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeRequestId','updatedAt'])
            && request.resource.data.updatedAt == request.time
            && ((resource.data.activeRequestId == '' && usable(resource.data)
                && request.resource.data.activeRequestId != ''
                && requestAfter(request.resource.data.activeRequestId).status == 'pending'
                && requestAfter(request.resource.data.activeRequestId).uid == uid)
              || (resource.data.activeRequestId != '' && request.resource.data.activeRequestId == ''
                && requestBefore(resource.data.activeRequestId).status == 'pending'
                && requestAfter(resource.data.activeRequestId).status == 'cancelled')))
          || (verified() && company(request.auth.uid) && resource.data.companyId == request.auth.uid && usable(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining','activeRequestId','updatedAt'])
            && request.resource.data.updatedAt == request.time && request.resource.data.remaining == resource.data.remaining - 1
            && resource.data.activeRequestId != '' && request.resource.data.activeRequestId == ''
            && requestBefore(resource.data.activeRequestId).status == 'pending'
            && requestAfter(resource.data.activeRequestId).status == 'confirmed'
            && ledgerAfter(resource.data.activeRequestId).uid == uid);
        allow delete: if false;
      }
      match /requests/{id} {
        allow read: if verified() && (admin() || resource.data.uid == request.auth.uid || (resource.data.companyId == request.auth.uid && company(request.auth.uid)));
        allow create: if verified() && enabled()
          && request.resource.data.keys().hasOnly(['uid','customerName','companyId','companyName','offerId','offerName','status','requestedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time
          && company(request.resource.data.companyId) && usable(subscription(request.auth.uid))
          && subscription(request.auth.uid).activeRequestId == '' && afterSubscription(request.auth.uid).activeRequestId == id
          && request.resource.data.customerName == subscription(request.auth.uid).name
          && request.resource.data.companyId == subscription(request.auth.uid).companyId
          && request.resource.data.companyName == subscription(request.auth.uid).companyName
          && request.resource.data.offerId == subscription(request.auth.uid).offerId
          && request.resource.data.offerName == subscription(request.auth.uid).offerName;
        allow update: if verified() && resource.data.status == 'pending'
          && ((resource.data.uid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledAt == request.time
              && subscription(resource.data.uid).activeRequestId == id && afterSubscription(resource.data.uid).activeRequestId == '')
            || (resource.data.companyId == request.auth.uid && company(request.auth.uid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmedAt','confirmedBy'])
              && request.resource.data.status == 'confirmed' && request.resource.data.confirmedAt == request.time
              && request.resource.data.confirmedBy == request.auth.uid && usable(subscription(resource.data.uid))
              && subscription(resource.data.uid).activeRequestId == id && afterSubscription(resource.data.uid).activeRequestId == ''
              && afterSubscription(resource.data.uid).remaining == subscription(resource.data.uid).remaining - 1
              && ledgerAfter(id).requestId == id));
        allow delete: if false;
      }
      match /redemptions/{id} {
        allow read: if verified() && (admin() || resource.data.uid == request.auth.uid || (resource.data.companyId == request.auth.uid && company(request.auth.uid)));
        allow create: if verified() && company(request.auth.uid)
          && request.resource.data.keys().hasOnly(['requestId','uid','customerName','companyId','companyName','offerId','offerName','quantity','payoutCents','paymentStatus','createdAt'])
          && request.resource.data.requestId == id && request.resource.data.companyId == request.auth.uid
          && request.resource.data.quantity == 1 && request.resource.data.paymentStatus == 'open'
          && request.resource.data.createdAt == request.time
          && requestBefore(id).status == 'pending' && requestAfter(id).status == 'confirmed'
          && requestBefore(id).uid == request.resource.data.uid
          && requestBefore(id).companyId == request.auth.uid
          && subscription(request.resource.data.uid).activeRequestId == id && usable(subscription(request.resource.data.uid))
          && afterSubscription(request.resource.data.uid).remaining == subscription(request.resource.data.uid).remaining - 1
          && afterSubscription(request.resource.data.uid).activeRequestId == ''
          && request.resource.data.customerName == subscription(request.resource.data.uid).name
          && request.resource.data.companyName == subscription(request.resource.data.uid).companyName
          && request.resource.data.offerId == subscription(request.resource.data.uid).offerId
          && request.resource.data.offerName == subscription(request.resource.data.uid).offerName
          && request.resource.data.payoutCents == subscription(request.resource.data.uid).payoutCents;
        allow update: if admin() && resource.data.paymentStatus == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus','paidAt','paidBy','paymentReference'])
          && request.resource.data.paymentStatus == 'paid' && request.resource.data.paidAt == request.time
          && request.resource.data.paidBy == request.auth.uid && request.resource.data.paymentReference is string
          && request.resource.data.paymentReference.size() >= 3 && request.resource.data.paymentReference.size() <= 160;
        allow delete: if false;
      }
    }

    match /services/{serviceId} {
      function lc(uid) { return get(/databases/$(database)/documents/services/$(serviceId)/loyaltyContracts/$(uid)).data; }
      function la(uid) { return getAfter(/databases/$(database)/documents/services/$(serviceId)/loyaltyContracts/$(uid)).data; }
      function br(id) { return get(/databases/$(database)/documents/services/$(serviceId)/bonusRequests/$(id)).data; }
      function ba(id) { return getAfter(/databases/$(database)/documents/services/$(serviceId)/bonusRequests/$(id)).data; }
      function bl(id) { return getAfter(/databases/$(database)/documents/services/$(serviceId)/bonusRedemptions/$(id)).data; }
      function partner(uid) { return verified() && get(/databases/$(database)/documents/services/$(serviceId)/companies/$(uid)).data.active == true; }
      function tariff(key) { return key == 'basic' ? {'price':2490,'units':2,'detail':1,'wash':2,'voucher':500} : key == 'plus' ? {'price':3490,'units':3,'detail':2,'wash':3,'voucher':1000} : {'price':5490,'units':5,'detail':3,'wash':4,'voucher':1500}; }
      function available(c,kind) {
        return kind == 'detail' ? int((c.paidMonths + 6) / 12) * tariff(c.planKey).detail - c.detailUsed
          : kind == 'bonusWash' ? int(c.paidMonths / 12) * tariff(c.planKey).wash - c.bonusWashUsed
          : int(c.paidMonths / 12) * tariff(c.planKey).voucher - c.voucherIssuedCents;
      }
      function activeSubscriber(uid) {
        let s=get(/databases/$(database)/documents/services/$(serviceId)/subscriptions/$(uid)).data;
        return s.active == true && s.validUntil > request.time && s.companyId == lc(uid).companyId && s.offerId == lc(uid).offerId;
      }
      function receiptAfter(id) { return getAfter(/databases/$(database)/documents/services/$(serviceId)/monthlyPayments/$(id)).data; }
      match /subscriptions/{uid} {
        allow get: if verified() && partner(request.auth.uid) && resource.data.companyId == request.auth.uid && lc(uid).companyId == request.auth.uid;
      }
      function benefitCounterUpdate(uid) {
        let d=request.resource.data;
        let kind=bl(d.lastBenefitId).kind;
        return d.lastBenefitId != resource.data.lastBenefitId && bl(d.lastBenefitId).uid == uid
          && ((kind == 'detail' && d.diff(resource.data).affectedKeys().hasOnly(['detailUsed','lastBenefitId','updatedAt','updatedBy']) && d.detailUsed == resource.data.detailUsed+1)
           || (kind == 'bonusWash' && d.diff(resource.data).affectedKeys().hasOnly(['bonusWashUsed','lastBenefitId','updatedAt','updatedBy']) && d.bonusWashUsed == resource.data.bonusWashUsed+1)
           || (kind == 'voucher' && d.diff(resource.data).affectedKeys().hasOnly(['voucherIssuedCents','lastBenefitId','updatedAt','updatedBy']) && d.voucherIssuedCents == resource.data.voucherIssuedCents+tariff(resource.data.planKey).voucher))
          && available(resource.data,kind)>0;
      }
      match /loyaltyContracts/{uid} {
        allow get: if own(uid) || admin() || (verified() && resource.data.companyId == request.auth.uid && partner(request.auth.uid));
        allow list: if admin() || (verified() && resource.data.companyId == request.auth.uid && partner(request.auth.uid));
        allow create: if serviceId == 'carwash' && admin()
          && request.resource.data.keys().hasOnly(['uid','name','companyId','companyName','offerId','contractId','planKey','planName','priceCents','monthlyUnits','paidMonths','lastPeriodStart','lastReceiptId','detailUsed','bonusWashUsed','voucherIssuedCents','lastBenefitId','washPayoutCents','detailPayoutCents','updatedAt','updatedBy'])
          && request.resource.data.uid == uid && request.resource.data.planKey in ['basic','plus','premium']
          && request.resource.data.priceCents == tariff(request.resource.data.planKey).price
          && request.resource.data.monthlyUnits == tariff(request.resource.data.planKey).units
          && request.resource.data.paidMonths == 0 && request.resource.data.lastPeriodStart == timestamp.value(0)
          && request.resource.data.lastReceiptId == '' && request.resource.data.detailUsed == 0
          && request.resource.data.bonusWashUsed == 0 && request.resource.data.voucherIssuedCents == 0
          && request.resource.data.lastBenefitId == '' && request.resource.data.washPayoutCents == 500 && request.resource.data.detailPayoutCents == 5000
          && request.resource.data.contractId is string && request.resource.data.contractId.size() >= 16
          && request.resource.data.companyId == get(/databases/$(database)/documents/services/$(serviceId)/subscriptions/$(uid)).data.companyId
          && request.resource.data.offerId == get(/databases/$(database)/documents/services/$(serviceId)/subscriptions/$(uid)).data.offerId
          && audit();
        allow update: if audit() && ((admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidMonths','lastPeriodStart','lastReceiptId','updatedAt','updatedBy'])
          && request.resource.data.paidMonths == resource.data.paidMonths+1 && request.resource.data.paidMonths <= 1200
          && request.resource.data.lastPeriodStart > resource.data.lastPeriodStart && request.resource.data.lastPeriodStart <= request.time
          && receiptAfter(request.resource.data.lastReceiptId).uid == uid
          && receiptAfter(request.resource.data.lastReceiptId).contractId == resource.data.contractId
          && receiptAfter(request.resource.data.lastReceiptId).periodStart == request.resource.data.lastPeriodStart
          && receiptAfter(request.resource.data.lastReceiptId).amountCents == resource.data.priceCents)
          || (verified() && benefitCounterUpdate(uid)
            && ((bl(request.resource.data.lastBenefitId).kind == 'voucher' && admin())
              || (bl(request.resource.data.lastBenefitId).kind in ['detail','bonusWash'] && resource.data.companyId == request.auth.uid && partner(request.auth.uid)))));
        allow delete: if false;
      }
      match /monthlyPayments/{id} {
        allow read: if admin() || (verified() && resource.data.uid == request.auth.uid);
        allow create: if serviceId == 'carwash' && admin()
          && request.resource.data.keys().hasOnly(['uid','contractId','period','periodStart','amountCents','reference','recordedAt','recordedBy'])
          && id == request.resource.data.contractId+'--'+request.resource.data.period
          && request.resource.data.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.periodStart == timestamp.date(int(request.resource.data.period.split('-')[0]),int(request.resource.data.period.split('-')[1]),1)
          && request.resource.data.contractId == lc(request.resource.data.uid).contractId
          && request.resource.data.amountCents == lc(request.resource.data.uid).priceCents
          && request.resource.data.periodStart is timestamp && request.resource.data.periodStart <= request.time
          && request.resource.data.periodStart > lc(request.resource.data.uid).lastPeriodStart
          && request.resource.data.reference is string && request.resource.data.reference.size() >= 3 && request.resource.data.reference.size() <= 160
          && request.resource.data.recordedAt == request.time && request.resource.data.recordedBy == request.auth.uid
          && la(request.resource.data.uid).paidMonths == lc(request.resource.data.uid).paidMonths+1
          && la(request.resource.data.uid).lastReceiptId == id;
        allow update, delete: if false;
      }
      match /bonusRequests/{id} {
        allow read: if admin() || (verified() && (resource.data.uid == request.auth.uid || (resource.data.companyId == request.auth.uid && partner(request.auth.uid))));
        allow create: if serviceId == 'carwash' && verified() && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','contractId','customerName','companyId','companyName','kind','status','requestedAt'])
          && request.resource.data.kind in ['detail','bonusWash','voucher']
          && request.resource.data.contractId == lc(request.auth.uid).contractId
          && request.resource.data.customerName == lc(request.auth.uid).name
          && request.resource.data.companyId == lc(request.auth.uid).companyId && request.resource.data.companyName == lc(request.auth.uid).companyName
          && request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time
          && available(lc(request.auth.uid),request.resource.data.kind)>0 && activeSubscriber(request.auth.uid);
        allow update: if verified() && resource.data.status == 'pending'
          && ((own(resource.data.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])
              && request.resource.data.status == 'cancelled' && request.resource.data.cancelledAt == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','confirmedAt','confirmedBy'])
              && request.resource.data.status == 'confirmed' && request.resource.data.confirmedAt == request.time && request.resource.data.confirmedBy == request.auth.uid
              && bl(id).requestId == id && la(resource.data.uid).lastBenefitId == id
              && ((resource.data.kind == 'voucher' && admin()) || (resource.data.kind != 'voucher' && resource.data.companyId == request.auth.uid && partner(request.auth.uid)))));
        allow delete: if false;
      }
      match /bonusRedemptions/{id} {
        allow read: if admin() || (verified() && (resource.data.uid == request.auth.uid || (resource.data.companyId == request.auth.uid && partner(request.auth.uid))));
        allow create: if serviceId == 'carwash' && verified()
          && request.resource.data.keys().hasOnly(['requestId','uid','contractId','customerName','companyId','companyName','offerId','offerName','kind','quantity','payoutCents','voucherCents','deliveryReference','paymentStatus','createdAt'])
          && request.resource.data.requestId == id && br(id).status == 'pending' && ba(id).status == 'confirmed'
          && request.resource.data.uid == br(id).uid && request.resource.data.kind == br(id).kind
          && request.resource.data.contractId == lc(request.resource.data.uid).contractId
          && request.resource.data.customerName == lc(request.resource.data.uid).name
          && request.resource.data.companyId == lc(request.resource.data.uid).companyId
          && request.resource.data.companyName == lc(request.resource.data.uid).companyName
          && request.resource.data.offerId == lc(request.resource.data.uid).offerId
          && request.resource.data.quantity == 1 && request.resource.data.paymentStatus == 'open' && request.resource.data.createdAt == request.time
          && activeSubscriber(request.resource.data.uid) && available(lc(request.resource.data.uid),request.resource.data.kind)>0
          && la(request.resource.data.uid).lastBenefitId == id
          && ((request.resource.data.kind == 'detail' && partner(request.auth.uid) && request.resource.data.companyId == request.auth.uid
              && request.resource.data.payoutCents == lc(request.resource.data.uid).detailPayoutCents && request.resource.data.voucherCents == 0
              && la(request.resource.data.uid).detailUsed == lc(request.resource.data.uid).detailUsed+1)
            || (request.resource.data.kind == 'bonusWash' && partner(request.auth.uid) && request.resource.data.companyId == request.auth.uid
              && request.resource.data.payoutCents == lc(request.resource.data.uid).washPayoutCents && request.resource.data.voucherCents == 0
              && la(request.resource.data.uid).bonusWashUsed == lc(request.resource.data.uid).bonusWashUsed+1)
            || (request.resource.data.kind == 'voucher' && admin() && request.resource.data.payoutCents == 0
              && request.resource.data.voucherCents == tariff(lc(request.resource.data.uid).planKey).voucher
              && request.resource.data.deliveryReference is string && request.resource.data.deliveryReference.size() >= 3 && request.resource.data.deliveryReference.size() <= 160
              && la(request.resource.data.uid).voucherIssuedCents == lc(request.resource.data.uid).voucherIssuedCents+tariff(lc(request.resource.data.uid).planKey).voucher));
        allow update: if admin() && resource.data.kind != 'voucher' && resource.data.paymentStatus == 'open'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus','paidAt','paidBy','paymentReference'])
          && request.resource.data.paymentStatus == 'paid' && request.resource.data.paidAt == request.time
          && request.resource.data.paidBy == request.auth.uid && request.resource.data.paymentReference is string
          && request.resource.data.paymentReference.size() >= 3 && request.resource.data.paymentReference.size() <= 160;
        allow delete: if false;
      }
    }

    // Free accounts are not subscriptions and confer no staff/admin privileges.
    match /platformProfiles/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || admin();
      allow list: if admin();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['uid','name','email','accountType','createdAt'])
        && request.resource.data.keys().hasOnly(['uid','name','email','accountType','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountType in ['customer','company']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /platformViews/{viewId} {
      allow get: if (verified() && viewId in [request.auth.uid + '_coffee',request.auth.uid + '_carwash']) || admin();
      allow list: if admin();
      allow create: if verified()
        && request.resource.data.keys().hasAll(['uid','category','firstViewedAt','lastViewedAt'])
        && request.resource.data.keys().hasOnly(['uid','category','firstViewedAt','lastViewedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['coffee','carwash']
        && viewId == request.auth.uid + '_' + request.resource.data.category
        && request.resource.data.firstViewedAt == request.time
        && request.resource.data.lastViewedAt == request.time
        && exists(/databases/$(database)/documents/platformProfiles/$(request.auth.uid));
      allow update: if own(resource.data.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastViewedAt'])
        && request.resource.data.lastViewedAt == request.time;
      allow delete: if false;
    }
    match /partnerRegistrationDrafts/{draftId} {
      function draftOwner() { return request.auth != null && draftId in [request.auth.uid + '_coffee',request.auth.uid + '_carwash']; }
      allow get: if draftOwner() || admin();
      allow list: if admin();
      allow create, update: if draftOwner()
        && request.resource.data.keys().hasAll(['uid','category','email','name','address','partnerAgreementVersion','partnerAgreementAt'])
        && request.resource.data.keys().hasOnly(['uid','category','email','name','address','partnerAgreementVersion','partnerAgreementAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.category in ['coffee','carwash']
        && draftId == request.auth.uid + '_' + request.resource.data.category
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 250
        && request.resource.data.partnerAgreementVersion == '2026-10-19'
        && request.resource.data.partnerAgreementAt == request.time;
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
