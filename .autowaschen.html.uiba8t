<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0c0d10"><meta name="robots" content="noindex,nofollow"><title>Mo Autowäsche · Kunde &amp; Firma</title><style>:root{color-scheme:dark;--bg:#0c0d10;--panel:#181b20;--gold:#e2bc7c;--text:#f7f2e9;--muted:#b7b4ad;--line:#e2bc7c30}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px/1.65 system-ui,sans-serif}a{color:var(--gold);text-decoration:none}button,input,select{font:inherit}button,a,input,select{touch-action:manipulation}button{cursor:pointer}button:disabled{opacity:.55;cursor:wait}header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:20px max(22px,calc((100vw - 1180px)/2));border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:13px;font-size:28px;font-weight:650}.brand img{width:62px;height:62px;object-fit:cover;border-radius:15px}.brand small{display:block;font-size:10px;letter-spacing:2px}nav,.actions{display:flex;gap:14px;flex-wrap:wrap;align-items:center}nav{font-size:13px}main{max-width:1180px;margin:auto;padding:0 24px 55px}.dev{text-align:center;padding:8px;background:#e2bc7c;color:#272219;font-size:11px}.wash-hero{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;gap:45px;padding:65px 0}.wash-hero h1{font:normal clamp(42px,6vw,72px)/1.08 Georgia,serif;margin:20px 0}.wash-hero em{color:var(--gold);font-weight:normal}.wash-hero p{color:var(--muted);max-width:480px}.car-art{background:radial-gradient(ellipse,#57687144,transparent 70%);padding:20px;color:var(--gold);text-align:center}.car-art svg{width:100%;max-width:420px}.car-art p{font:27px Georgia,serif;color:var(--gold)}.tag{font-size:10px;letter-spacing:2px;color:var(--gold);text-transform:uppercase;font-weight:700}.card{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:28px;margin:24px 0}h2{font:normal 32px Georgia,serif;margin:10px 0 20px}h3{font-size:19px;margin:28px 0 13px}.split{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.notice{border-left:3px solid var(--gold);padding:14px 18px;background:#e2bc7c0d;overflow-wrap:anywhere}.muted,small{color:var(--muted)}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.form-grid .actions{grid-column:1/-1}label{display:grid;gap:6px;font-size:12px;color:var(--muted)}input,select{width:100%;min-width:0;background:#0d1117;border:1px solid #777365;border-radius:7px;padding:11px 13px;color:var(--text)}button,.actions a,a.primary{display:inline-flex;align-items:center;justify-content:center;border:1px solid #777365;background:#23272e;color:var(--text);border-radius:7px;padding:10px 15px;font-size:13px;font-weight:550}.primary{background:var(--gold)!important;color:#211b11!important;border-color:var(--gold)!important}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stats article{border:1px solid var(--line);padding:18px;border-radius:9px}.stats strong{display:block;color:var(--gold);font-size:25px;overflow-wrap:anywhere}.stats small{font-size:11px}.package-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:15px}.offer,.list>article{border:1px solid var(--line);border-radius:10px;padding:20px}.offer h3{margin:0 0 12px}.offer strong{display:block;font-size:24px;color:var(--gold)}.list{display:grid;gap:13px}.list p{margin:5px 0;overflow-wrap:anywhere}.list small{display:block}.actions{margin-top:18px}[hidden],.hidden{display:none!important}footer{border-top:1px solid var(--line);padding-top:25px;display:flex;gap:20px;flex-wrap:wrap;color:var(--muted);font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;background:#101317;padding:20px;max-height:500px;overflow:auto}.service-tabs{display:flex;gap:10px;flex-wrap:wrap;padding:18px 0}.service-tabs button[aria-pressed=true]{background:var(--gold);color:#17130e}.service-admin .form-grid{margin-bottom:20px}.service-admin section{margin:25px 0}.service-admin .list button{margin:8px 8px 0 0}dialog{width:min(680px,calc(100% - 28px));max-height:90vh;overflow:auto;background:#181b20;color:var(--text);border:1px solid var(--gold);border-radius:15px;padding:27px}dialog::backdrop{background:#000b}:focus-visible{outline:3px solid var(--gold);outline-offset:3px}.read-only{font-size:12px;color:var(--muted)}@media(max-width:740px){.wash-hero{grid-template-columns:1fr;padding:40px 0;gap:5px}.car-art svg{max-width:280px}.car-art{padding:0}.car-art p{font-size:22px}.form-grid,.package-grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr}.stats article{padding:14px}.stats strong{font-size:23px}.card{padding:20px}header{align-items:start;padding:16px 20px;gap:12px}nav{flex-direction:column;align-items:flex-end;gap:7px;font-size:11px}.brand{font-size:24px}.brand img{width:48px;height:48px}.brand small{font-size:8px}main{padding:0 18px 40px}.service-admin .form-grid{grid-template-columns:1fr}.service-tabs button{font-size:12px;padding:9px}}
.tariff ul{padding-left:18px;color:var(--muted);font-size:13px}.tariff li{margin:12px 0}.tariff small{font-size:12px}.tariff a.primary{display:inline-block;padding:10px 14px;border-radius:7px}.tariff{display:flex;flex-direction:column}.tariff a{margin-top:auto}.top-offer{border:2px solid var(--gold);background:linear-gradient(140deg,#393025,#202125)}.tariff-grid{margin:24px 0}.tariff h3{font:32px Georgia,serif;margin-top:15px}#loyaltyCustomer button{margin:8px 8px 0 0}#loyaltyAdminList button{margin:8px 8px 0 0}
.tariff-grid{gap:26px;align-items:stretch;margin:32px 0}.tariff{padding:32px 26px;min-width:0;border-radius:17px}.tariff h3{font-size:46px;line-height:1.12;margin:22px 0}.tariff .tag{font-size:13px;letter-spacing:1.5px}.tariff>strong{font-size:44px;line-height:1.2;margin-bottom:8px}.tariff>strong small{font-size:15px}.tariff>p{font-size:19px;line-height:1.6}.tariff ul{font-size:17px;line-height:1.8;padding-left:23px}.tariff li{margin:18px 0}.tariff a.primary{min-height:56px;padding:15px 18px;font-size:16px;text-align:center}.top-offer{border-width:3px}#tarife>h2{font-size:42px;line-height:1.2}#tarife>p{font-size:17px;line-height:1.8}@media(max-width:1050px){.tariff-grid{grid-template-columns:1fr}.tariff{padding:32px}.tariff h3{font-size:46px}.tariff>strong{font-size:46px}}@media(max-width:480px){.tariff-grid{gap:25px}.tariff{padding:27px 22px}.tariff h3{font-size:41px}.tariff>strong{font-size:42px}.tariff>p{font-size:18px}.tariff ul{font-size:17px}.tariff a.primary{font-size:16px;padding:15px 12px}#tarife>h2{font-size:35px}}

#tarife.card{background:transparent;border:0;padding:34px 0 0;margin-top:12px}#tarife .pricing-symbols{position:absolute;overflow:hidden}#tarife .pricing-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:25px;margin-bottom:44px}#tarife .pricing-heading .tag{font-size:10px;letter-spacing:2px}#tarife #tariffTitle{font:normal clamp(34px,4.3vw,51px)/1.12 Georgia,serif;margin:17px 0 0;letter-spacing:-1px}#tarife #tariffTitle em{color:var(--gold);font-weight:normal}#tarife .pricing-heading>p{color:#b9b5ad;font-size:13px;line-height:1.8;margin:0}
#tarife .tariff-grid{gap:21px;align-items:stretch;margin:0 0 34px}#tarife .tariff{position:relative;isolation:isolate;overflow:hidden;min-width:0;border:1px solid #9d85654d;border-radius:20px;padding:28px 25px;background:radial-gradient(ellipse at 100% 0%,#9c7b3a24,transparent 50%),linear-gradient(150deg,#24262a,#111418 70%);box-shadow:0 18px 50px #0004;color:#f8f1e3;transition:transform .2s,box-shadow .2s}#tarife .tariff:after{content:'';position:absolute;inset:0;pointer-events:none;border-radius:inherit;background:linear-gradient(120deg,#ffffff0a,transparent 45%)}#tarife .tariff:hover{transform:translateY(-4px);box-shadow:0 22px 55px #0007}#tarife .tier-top{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:9px;letter-spacing:1.7px;color:#b9ac94}#tarife .tier-pill{padding:4px 9px;border:1px solid #c6a66b55;border-radius:20px;font-size:8px;letter-spacing:1.4px;color:#e1c58c}#tarife .tariff h3{font:normal 36px/1.12 Georgia,serif;margin:22px 0 7px;letter-spacing:-.5px}#tarife .tariff .tier-subline{font-size:12px;line-height:1.6;margin:0;color:#bcb6ac}#tarife .tier-art{height:126px;margin:18px -16px 5px;display:grid;align-items:center;position:relative;color:#c5aa79}#tarife .tier-art:before{content:'';position:absolute;inset:5% 0;background:radial-gradient(ellipse,#cda46030,transparent 66%);z-index:-1}#tarife .tier-art svg{width:100%;height:auto;max-height:126px;filter:drop-shadow(0 10px 8px #0003)}#tarife .tier-price{display:flex;align-items:baseline;gap:9px;margin:10px 0 20px}#tarife .tier-price>strong{display:block;color:#f3d39b;font:550 44px/1.1 system-ui,sans-serif;letter-spacing:-2px}#tarife .tier-price>strong span{font-size:23px;letter-spacing:-.5px}#tarife .tier-price>small{font-size:11px;color:#b8ac96}#tarife .tier-main{display:flex;align-items:center;gap:14px;border-top:1px solid #d9bd8933;border-bottom:1px solid #d9bd8933;padding:17px 0;margin-bottom:18px}#tarife .tier-main strong{font:normal 45px/1 Georgia,serif;color:#ead2a3;display:inline-block}#tarife .tier-main span{font-size:12px;line-height:1.6;color:#ded6c8}#tarife .release-label{display:block;font-size:8px;letter-spacing:1.1px;color:#c0ae8e;font-weight:600}#tarife .tier-detail{padding:5px 0 17px}#tarife .tier-detail p{font-size:12px;margin:8px 0 0;color:#ded6c8}#tarife .tier-detail strong{display:inline-block;font-size:20px;color:#f0d197;margin-right:6px}#tarife .tier-gifts{background:#e2bc7c0c;border:1px solid #d9bd892e;border-radius:10px;padding:13px 12px;margin-bottom:22px}#tarife .tier-gifts>div{display:grid;grid-template-columns:1fr 1.2fr;gap:8px;margin-top:13px}#tarife .tier-gifts p{margin:0}#tarife .tier-gifts p+p{border-left:1px solid #c9ad7740;padding-left:12px}#tarife .tier-gifts strong{font:600 21px/1.1 system-ui,sans-serif;display:block;color:#f0d197;letter-spacing:-.6px}#tarife .tier-gifts small{display:block;font-size:9px;line-height:1.5;margin-top:7px;color:#c3b8a4}#tarife .tariff a.primary{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:46px;padding:12px 15px;border-radius:8px;font-size:12px;text-align:left;border:1px solid #d0b479!important;background:linear-gradient(100deg,#e9cc93,#c19b5b)!important;color:#221a0d!important;text-decoration:none;margin-top:auto;position:relative;z-index:1}
#tarife .tariff-plus{border-color:#f1d9a2;padding-top:53px;color:#292115;background:radial-gradient(ellipse at 10% 0%,#fff4d4,transparent 65%),linear-gradient(140deg,#edcf92,#b8904b);box-shadow:0 0 0 4px #e5c27b12,0 18px 60px #b5914720}#tarife .top-ribbon{position:absolute;top:0;left:0;right:0;background:#322717;color:#f7dda3;text-align:center;padding:8px;font-size:9px;font-weight:750;letter-spacing:2.3px}#tarife .tariff-plus .tier-art{color:#393d41}#tarife .tariff-plus .tier-top,#tarife .tariff-plus .tier-subline,#tarife .tariff-plus .tier-price>small,#tarife .tariff-plus .release-label,#tarife .tariff-plus .tier-main span,#tarife .tariff-plus .tier-detail p,#tarife .tariff-plus .tier-gifts small{color:#56452b}#tarife .tariff-plus .tier-pill{border-color:#71572b55;color:#4c391c}#tarife .tariff-plus .tier-price>strong,#tarife .tariff-plus .tier-main strong,#tarife .tariff-plus .tier-detail strong,#tarife .tariff-plus .tier-gifts strong{color:#322616}#tarife .tariff-plus .tier-main{border-color:#6b512a44}#tarife .tariff-plus .tier-gifts{background:#fff3cf40;border-color:#82602f44}#tarife .tariff-plus .tier-gifts p+p{border-color:#82602f44}#tarife .tariff-plus a.primary{background:#2c2419!important;border-color:#2c2419!important;color:#ffe5ae!important}#tarife .tariff-premium{background:radial-gradient(ellipse at 100% 0%,#8497ab24,transparent 55%),linear-gradient(140deg,#273440,#101920);border-color:#b3c2cb66}#tarife .tariff-premium .tier-art{color:#c6d2da}#tarife .tariff-premium .tier-art:before{background:radial-gradient(ellipse,#b3c5d338,transparent 66%)}
#tarife .extras-warning{margin:30px 0 20px;background:#302217;border:1px solid #e1a65a88;border-left:4px solid #edb66c;border-radius:13px;padding:25px;color:#f6e6cd}#tarife .extras-heading{display:flex;align-items:center;gap:15px}#tarife .extras-icon{display:grid;place-items:center;flex-shrink:0;width:38px;height:38px;background:#eab773;color:#3e2813;border-radius:50%;font-size:24px;font-weight:800}#tarife .extras-badge{font-size:9px;letter-spacing:1.4px;color:#f3bc75;font-weight:750}#tarife .extras-warning h3{font:normal 24px/1.3 Georgia,serif;margin:6px 0 0;color:#fff0d8}#tarife .extras-warning .included-scope{font-size:12px;color:#e3cbaa;line-height:1.8;margin:20px 0}#tarife .extras-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}#tarife .extras-grid article{background:#140d0640;border:1px solid #e1a65a40;padding:18px;border-radius:9px}#tarife .extras-grid .dirt-notice{border-color:#e1a65aa0;background:#5d381d44}#tarife .extras-label{font-size:8px;letter-spacing:1.4px;color:#f2bc79;font-weight:750}#tarife .extras-grid h4{font:650 15px/1.5 system-ui,sans-serif;margin:10px 0;color:#fff0d8}#tarife .extras-grid p{font-size:12px;line-height:1.8;margin:0;color:#dec3a0}#tarife .price-agreement{font-size:12px;line-height:1.8;margin:20px 0 0;border-top:1px solid #e1a65a44;padding-top:17px;color:#f4dab4}#tarife .tariff-terms{border-top:1px solid #e2bc7c33;padding:17px 0}#tarife .tariff-terms summary{font-size:12px;color:#d7c4a3;cursor:pointer}#tarife .tariff-terms p{font-size:12px;line-height:1.8;color:#b8b1a6}
@media(min-width:1001px){#tarife .tariff-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:1000px){#tarife .tariff-grid{grid-template-columns:1fr;max-width:580px;margin-left:auto;margin-right:auto;gap:28px}#tarife .tariff{padding:30px}#tarife .tariff-plus{padding-top:56px}#tarife .tier-art{height:145px}#tarife .tier-art svg{max-height:145px}#tarife .tier-gifts small{font-size:11px}#tarife .release-label{font-size:9px}}@media(max-width:600px){#tarife .pricing-heading{display:block;margin-bottom:30px}#tarife .pricing-heading>p{margin-top:15px;font-size:12px}#tarife #tariffTitle{font-size:36px;max-width:290px}#tarife .pricing-heading .tag{font-size:8px;letter-spacing:1.4px}#tarife .tariff{padding:26px 24px}#tarife .tariff-plus{padding-top:53px}#tarife .tariff h3{font-size:36px}#tarife .tier-art{height:128px}#tarife .tier-art svg{max-height:128px}#tarife .tier-price>strong{font-size:44px}#tarife .tier-detail p,#tarife .tier-main span{font-size:12px}#tarife .tier-gifts small{font-size:10px}#tarife .tier-price>small{font-size:11px}#tarife .tier-top{font-size:8px}#tarife .tariff a.primary{font-size:12px;min-height:47px}#tarife .extras-warning{padding:20px 18px}#tarife .extras-grid{grid-template-columns:1fr}#tarife .extras-heading{gap:11px;align-items:start}#tarife .extras-warning h3{font-size:23px}#tarife .extras-badge{font-size:8px;letter-spacing:1px}}@media(prefers-reduced-motion:reduce){#tarife .tariff{transition:none}#tarife .tariff:hover{transform:none}}

#tarife .tier-art.car-photo{height:175px;margin:20px -16px 12px;border-radius:12px;background-image:var(--car-photo-sprite);background-repeat:no-repeat;background-size:300% auto;background-position:0% 50%;box-shadow:inset 0 0 0 1px #ffffff12}#tarife .tier-art.car-photo:before{display:none}#tarife .tariff-plus .car-photo{background-position:50% 50%}#tarife .tariff-premium .car-photo{background-position:100% 50%}#tarife .premium-title{display:flex;align-items:center;gap:12px;margin:22px 0 7px}#tarife .premium-title h3{margin:0}#tarife .premium-crown{width:40px;height:36px;flex:none;color:#edc97b;filter:drop-shadow(0 3px 9px #e7bd6444)}@media(max-width:1000px){#tarife .tier-art.car-photo{height:200px}}@media(max-width:600px){#tarife .tier-art.car-photo{height:175px}}

.car-art.hero-car{padding:0;min-width:0;overflow:hidden;background:radial-gradient(ellipse at 50% 65%,#536d8240,transparent 70%)}.hero-car-photo{width:100%;aspect-ratio:1.45;background-image:var(--car-photo-sprite);background-size:300% auto;background-position:100% 50%;background-repeat:no-repeat;border-radius:24px;box-shadow:0 24px 70px #0004,inset 0 0 0 1px #d8bc7d20;mask-image:linear-gradient(to bottom,#000 82%,transparent)}.car-art.hero-car p{max-width:none;margin:8px 0 0;text-align:center}@media(max-width:600px){.hero-car-photo{aspect-ratio:1.45;border-radius:16px}.car-art.hero-car{margin-top:18px}}

.mosabo-role{grid-column:1/-1;border:1px solid #d8b47c66;border-left:4px solid #d8b47c;border-radius:14px;background:#d8b47c0b;padding:20px;margin:20px 0;color:inherit}.mosabo-role h3{font:normal 24px/1.25 Georgia,serif;margin:0 0 12px}.mosabo-role p{font-size:13px;line-height:1.7;margin:10px 0;max-width:none}.mosabo-role strong{color:inherit}@media(max-width:600px){.mosabo-role{padding:16px}.mosabo-role h3{font-size:22px}}

:root{--car-photo-sprite:url("data:image/png;base64,